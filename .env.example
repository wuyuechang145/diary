# Docker local preview. No editing is required for localhost.
APP_PORT=3000
DOCKER_PUBLIC_ORIGIN=http://localhost:3000
MYSQL_POOL_SIZE=10

# Local npm development settings (Docker overrides these internally).
# Configure these only when running npm run dev without Docker.
NUXT_SESSION_SECRET=

# Exact browser origin. Keep this local value for npm run dev; use HTTPS in production.
PUBLIC_ORIGIN=http://127.0.0.1:5173

# MySQL connection used by the Nuxt server only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional server-side Redis cache and distributed rate limits. Never expose to the browser.
# Use redis://:password@host:6379/0 for a password-protected instance.
REDIS_URL=
# Only trust X-Forwarded-For from these immediate reverse-proxy IPs (comma separated).
TRUSTED_PROXY_IPS=

# OpenAI-compatible chat-completions provider. Keep real values in .env only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
